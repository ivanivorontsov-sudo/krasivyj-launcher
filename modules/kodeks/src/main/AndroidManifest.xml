<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <application>
        <activity
            android:name="org.ivanivorontsov.kodekszhizni.MainActivity"
            android:exported="true"
            android:label="@string/mod_kodeks_name"
            android:icon="@mipmap/mod_kodeks_icon"
            android:theme="@style/Theme.KodeksZhizni"
            android:taskAffinity="org.ivanivorontsov.launcher.mod.kodeks"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <receiver android:name="org.ivanivorontsov.kodekszhizni.worker.BootReceiver" android:exported="true">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
    </application>
</manifest>
